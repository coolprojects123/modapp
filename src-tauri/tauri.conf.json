{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modapp",
  "version": "1.0.0",
  "identifier": "com.modapp.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "node scripts/dev-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "modapp",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "style-src": "'self' asset: http://asset.localhost https://asset.localhost https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost https:",
        "media-src": "'self' blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "style-src": "'self' asset: http://asset.localhost https://asset.localhost https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost https:",
        "media-src": "'self' blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost ws://127.0.0.1:1430 http://127.0.0.1:1430",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/mods/**",
          "$APPDATA/mod-data/music-player/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Akhilesh Gollapudi",
    "category": "Utility",
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.svg",
      "icons/icon.ico"
    ],
    "resources": [
      "../mods"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-ugly-free",
          "gstreamer1-libav"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/coolprojects123/modapp/releases/latest/download/latest.json"
      ]
    }
  }
}