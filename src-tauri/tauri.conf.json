{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "modapp",
  "version": "1.0.0",
  "identifier": "com.modapp.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "modapp",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/mods/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "resources": ["../mods", "../settings.json", "../mods-config.json"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
