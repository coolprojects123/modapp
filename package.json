{
  "name": "modapp",
  "version": "1.0.0",
  "description": "A lightweight modular desktop app",
  "homepage": "https://example.com/modapp",
  "author": {
    "name": "modapp",
    "email": "hello@example.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:electron": "electron-builder",
    "build:electron:linux": "electron-builder --linux",
    "build:electron:rpm": "electron-builder --linux rpm",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "build": {
    "appId": "com.modapp.desktop",
    "productName": "modapp",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "public/**",
      "mods/**",
      "mods-config.json",
      "settings.json",
      "package.json",
      "!src-tauri/**",
      "!**/*.map"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "src-tauri/icons/icon.png"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
