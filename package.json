{
  "name": "modapp",
  "version": "3.0.0",
  "description": "A lightweight modular desktop app",
  "homepage": "https://github.com/coolprojects123/modapp/",
  "author": {
    "name": "modapp",
    "email": "hello@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coolprojects123/modapp.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:windows": "electron-builder --win --publish never",
    "test": "node --test electron/*.test.js",
    "build:mac": "electron-builder --mac --publish never",
    "sign": "node scripts/sign.js",
    "sign:windows": "node scripts/sign.js --platform=win32",
    "sign:mac": "node scripts/sign.js --platform=darwin",
    "sign:linux": "node scripts/sign.js --platform=linux",
    "sign:dev": "node scripts/sign-dev.js",
    "sign:dev:win": "node scripts/sign-dev.js --account=$EVS_ACCOUNT_NAME --password=$EVS_PASSWD",
    "sign:dev:mac": "node scripts/sign-dev.js --account=$EVS_ACCOUNT_NAME --password=$EVS_PASSWD"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "git+https://github.com/castlabs/electron-releases.git#v44.5.1+wvcus",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1+wvcus": true,
    "electron-builder@26.15.3": true,
    "electron-winstaller": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.modapp.desktop",
    "productName": "modapp",
    "afterSign": "build/evs-sign.js",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "public/**",
      "mods-config.json",
      "settings.json",
      "package.json",
      "!**/*.map"
    ],
    "resources": [
      "mods/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "coolprojects123",
      "repo": "modapp",
      "releaseType": "draft"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "electron/icon.png"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "artifactName": "modapp-Setup-${version}.${ext}"
    }
  }
}
