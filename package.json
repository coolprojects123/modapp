{
  "name": "modapp",
  "version": "1.2.1",
  "description": "A lightweight modular desktop app",
  "homepage": "https://github.com/coolprojects123/modapp/",
  "author": {
    "name": "modapp",
    "email": "hello@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coolprojects123/modapp.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:windows": "electron-builder --win --publish never",
    "test": "node --test electron/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "git+https://github.com/castlabs/electron-releases.git#v44.1.0+wvcus",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "electron-builder@26.15.3": true,
    "electron-winstaller": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.modapp.desktop",
    "productName": "modapp",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "public/**",
      "mods/**",
      "mods-config.json",
      "settings.json",
      "package.json",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "coolprojects123",
      "repo": "modapp",
      "releaseType": "draft"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "electron/icon.png"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
